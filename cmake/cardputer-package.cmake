# Debian/APPLaunch layout adapted for BitaxeZero, following CardputerZero Template.
option(BX_ENABLE_DEB "Enable the ARM64 Debian packaging target" OFF)
set(BX_DEB_MAINTAINER "" CACHE STRING "Approved package contact: Name <email>")
set(BX_APP_ICON "" CACHE FILEPATH "Path to generated 256 x 256 PNG icon")
if(NOT BX_ENABLE_DEB)
  return()
endif()
if(NOT BX_DEB_MAINTAINER MATCHES "^[^<>]+ <[^<> ]+@[^<> ]+>$")
  message(FATAL_ERROR "Set the approved BX_DEB_MAINTAINER contact before preparing a Debian package.")
endif()
if(NOT EXISTS "${BX_APP_ICON}")
  message(FATAL_ERROR "Generate the launcher PNG and set BX_APP_ICON.")
endif()

# LVGL is linked statically and registers its own default development install rules.
# Package only this application's runtime component, not the default ALL install.
set(_bx_runtime "BitaxeZeroRuntime")
install(TARGETS bitaxezero RUNTIME DESTINATION bin COMPONENT "${_bx_runtime}")
install(FILES packaging/bitaxezero.desktop DESTINATION share/APPLaunch/applications COMPONENT "${_bx_runtime}")
install(FILES "${BX_APP_ICON}" DESTINATION share/APPLaunch/share/images RENAME bitaxezero.png COMPONENT "${_bx_runtime}")
install(FILES LICENSE README.md THIRD-PARTY-NOTICES.md DESTINATION share/doc/bitaxezero COMPONENT "${_bx_runtime}")
if(EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/licenses")
  install(DIRECTORY licenses/ DESTINATION share/doc/bitaxezero/licenses COMPONENT "${_bx_runtime}")
endif()
set(CPACK_INSTALL_CMAKE_PROJECTS "${CMAKE_BINARY_DIR};${CMAKE_PROJECT_NAME};${_bx_runtime};/")
set(CPACK_GENERATOR "DEB")
set(CPACK_PACKAGING_INSTALL_PREFIX "/usr")
set(CPACK_PACKAGE_NAME "bitaxezero")
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "Bitaxe miner monitor for the M5Stack Cardputer Zero")
set(CPACK_PACKAGE_VERSION "${PROJECT_VERSION}")
set(CPACK_DEBIAN_PACKAGE_NAME "bitaxezero")
set(CPACK_DEBIAN_PACKAGE_ARCHITECTURE "arm64")
set(CPACK_DEBIAN_PACKAGE_RELEASE "1")
set(CPACK_DEBIAN_PACKAGE_MAINTAINER "${BX_DEB_MAINTAINER}")
set(CPACK_DEBIAN_PACKAGE_SECTION "utils")
set(CPACK_DEBIAN_PACKAGE_DEPENDS "libc6, libstdc++6, libgcc-s1")
set(CPACK_DEBIAN_FILE_NAME DEB-DEFAULT)
include(CPack)
